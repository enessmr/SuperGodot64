    <library_effects>
        <effect id="effect1">
            <profile_COMMON>
                <newparam sid="surface1">
                    <surface type="2D">
                        <init_from>tex_vertexColors</init_from>
                    </surface>
                </newparam>
                <newparam sid="sampler1">
                    <sampler2D>
                        <source>surface1</source>
                    </sampler2D>
                </newparam>
                <technique sid="COMMON">
                    <blinn>
                        <diffuse>
                            <texture texture="sampler1" texcoord="UVSET0"></texture>
                        </diffuse>
                    </blinn>
                </technique>
            </profile_COMMON>
        </effect>
    </library_effects>
    <library_materials>
